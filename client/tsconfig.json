{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"jsx": "preserve",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"skipLibCheck": true,
		"esModuleInterop": true,
		"useDefineForClassFields": true,
		"noUnusedLocals": true
	},
	"include": ["src", "vite.config.ts"]
}
